# Copiar a .env en la raíz. docker compose y la API leen este archivo.
# El Postgres de Docker se publica en el 5433 para no chocar con un PostgreSQL instalado en Windows (5432).
POSTGRES_USER=his
POSTGRES_PASSWORD=his
POSTGRES_DB=his
POSTGRES_PORT=5433

DATABASE_URL=postgresql://his:his@localhost:5433/his?schema=public
PORT=3000
NODE_ENV=development

# Módulo IAM. Cambiar el secreto en cualquier entorno que no sea local.
JWT_SECRET=cambiar-este-secreto
JWT_EXPIRES_IN=8h
# Administrador inicial que crea `pnpm db:seed` (con esto se hace el primer login).
ADMIN_EMAIL=admin@his.local
ADMIN_PASSWORD=Admin1234!
